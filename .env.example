# Required for the supported server-side review path.
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.6-luna
LLM_API_KEY=
LLM_TIMEOUT_MS=15000
# Required to reproduce the published evaluation configuration.
LLM_REASONING_EFFORT=none

# Operational settings. Empty CORS_ALLOWLIST means same-origin only.
CORS_ALLOWLIST=

MAX_DRAFT_CHARS=12000
RATE_LIMIT_PER_MIN=10
